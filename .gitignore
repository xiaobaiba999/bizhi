# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 桌面版打包产物（安装包不进 git：GitHub 单文件 100MB 硬限制）
/.next-desktop/
/release/
/public/desktop/
/download/*.exe

# 本地运行数据与日志（含登录令牌等敏感数据，绝不入库）
/db/
/dev.log
/build-desktop.log
/upload/
