{
  "name": "wallpaper-workshop-desktop",
  "productName": "壁纸工坊",
  "version": "1.4.14",
  "private": true,
  "description": "壁纸工坊 Windows 桌面版（Electron 封装：app:// 协议 + 下载接管 + 保存通知 + 记录文件真源 + 自定义保存位置 + 微信扫码登录原图下载 + 崩溃可见化/运行日志 + 官网同步满屏加载 + 原图下载字节级质量校验 + 官方元数据期望宽高完整性硬校验）",
  "author": "xiaobaiba999",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.xiaobaiba999.wallpaperworkshop",
    "productName": "壁纸工坊",
    "copyright": "Copyright © 2026 xiaobaiba999",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "zf-login.js",
      "zf-meta.js",
      "image-quality.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WallpaperWorkshop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "壁纸工坊",
      "uninstallDisplayName": "壁纸工坊 WallpaperWorkshop",
      "deleteAppDataOnUninstall": false
    }
  }
}
