{
  "name": "wallpaper-workshop-desktop",
  "productName": "壁纸工坊",
  "version": "1.4.7",
  "private": true,
  "description": "壁纸工坊 Windows 桌面版（Electron 封装：app:// 协议 + 下载接管 + 保存通知）",
  "author": "xiaobaiba999",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.xiaobaiba999.wallpaperworkshop",
    "productName": "壁纸工坊",
    "copyright": "Copyright © 2026 xiaobaiba999",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "WallpaperWorkshop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "壁纸工坊",
      "uninstallDisplayName": "壁纸工坊 WallpaperWorkshop",
      "deleteAppDataOnUninstall": false
    }
  }
}
