{
  "name": "wallpaper-workshop-desktop",
  "productName": "壁纸工坊",
  "version": "2.0.0",
  "private": true,
  "description": "壁纸工坊 Windows 桌面版（Electron：app:// 协议 + 微信扫码登录原图下载 + OriginalDownloadService 统一链路 + 官方元数据完整性硬校验 + SQLite 永久下载历史 + 官网风控受限熔断）",
  "author": "xiaobaiba999",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.xiaobaiba999.wallpaperworkshop",
    "productName": "壁纸工坊",
    "copyright": "Copyright © 2026 xiaobaiba999",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "zf-login.js",
      "zf-certify.js",
      "zf-meta.js",
      "original-download.js",
      "history-db.js",
      "image-quality.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "node_modules/sql.js/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WallpaperWorkshop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "壁纸工坊",
      "uninstallDisplayName": "壁纸工坊 WallpaperWorkshop",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "sql.js": "1.13.0"
  }
}
