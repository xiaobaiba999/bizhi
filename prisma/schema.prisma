generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 下载记录（v2.0 完整档案）：每条成功下载的原图记录
/// 只有文件完整保存且质量校验通过后由 /api/wallpapers/download 写入
model Download {
  /// 壁纸文件 id（CDN 文件名去扩展名 = 官网 wallpaperId，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  /// 下载质量：original（令牌换取的官网原图；v2.0 起只记录原图）
  quality   String   @default("original")
  /// v2.0：computer | phone | null（未知）
  category  String?
  /// v2.0：实际宽度（px，质量校验通过后回填）
  width     Int?
  /// v2.0：实际高度（px）
  height    Int?
  /// v2.0：真实格式（png/jpeg/webp，按字节魔数判定）
  format    String?
  /// v2.0：文件大小（字节）
  bytes     Int?
  /// v2.0：内容 SHA-256（完整校验凭证）
  sha256    String?
  createdAt DateTime @default(now())
}

// 哲风壁纸登录令牌（仅保存在本地数据库，用于下载原图鉴权）
model ZfToken {
  id        String   @id @default(cuid())
  token     String   @unique
  /// 来源说明：manual(手动粘贴) | qrcode(扫码登录)
  note      String
  createdAt DateTime @default(now())
}

/// 屏蔽记录：屏蔽过的壁纸永久不再显示
model Blocked {
  /// 壁纸文件 id（CDN 文件名去扩展名，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  createdAt DateTime @default(now())
}
