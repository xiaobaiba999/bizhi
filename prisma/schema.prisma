generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 下载记录：下载过的壁纸自动隐藏（「隐藏已下载」开启时）
model Download {
  /// 壁纸文件 id（CDN 文件名去扩展名，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  createdAt DateTime @default(now())
}

/// 屏蔽记录：屏蔽过的壁纸永久不再显示
model Blocked {
  /// 壁纸文件 id（CDN 文件名去扩展名，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  createdAt DateTime @default(now())
}
