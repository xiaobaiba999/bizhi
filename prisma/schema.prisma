generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 下载记录：下载过的壁纸自动隐藏（「隐藏已下载」开启时）
model Download {
  /// 壁纸文件 id（CDN 文件名去扩展名，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  /// 下载质量：preview（预览直链约 1100px）| original（令牌换取的官网原图）
  quality   String   @default("preview")
  createdAt DateTime @default(now())
}

// 哲风壁纸登录令牌（仅保存在本地数据库，用于下载原图鉴权）
model ZfToken {
  id        String   @id @default(cuid())
  token     String   @unique
  /// 来源说明：manual(手动粘贴) | qrcode(扫码登录)
  note      String
  createdAt DateTime @default(now())
}

/// 屏蔽记录：屏蔽过的壁纸永久不再显示
model Blocked {
  /// 壁纸文件 id（CDN 文件名去扩展名，唯一键）
  id        String   @id
  title     String
  src       String
  wtId      String?
  createdAt DateTime @default(now())
}
